<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!--
	  本模组零 Harmony 补丁（喂 CreationDefinition 的原版工具管线路线），不引用 Lib.Harmony。
	  发布打包与部署的事实标准是 scripts\pack-release.js / deploy-local.js（内含 130+ 枚钉子自检）；
	  dotnet build 走官方工具链（CSII_TOOLPATH），用于 IDE 与编译校验（scripts\compile-check.js 同口径）。
	-->
	<Target Name="RunModPostProcessor" AfterTargets="AfterBuild" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)'">
		<Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found: $(ModPostProcessorFullPath)" />
		<Message Text="Run post processor: $(ModPostProcessorArgs)" Importance="high" />
		<Exec Command="$(ModPostProcessorArgs)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" LogStandardErrorAsError="true" />
	</Target>

	<Target Name="RunModPublisher" AfterTargets="Publish">
		<Error Condition="!Exists('$(ModPublisherPath)')" Text="Mod publisher not found: $(ModPublisherPath)" />
		<Message Text="Run mod publisher: $(ModPublisherArgs)" Importance="high" />
		<Exec Command="$(ModPublisherArgs)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" LogStandardErrorAsError="true" />
	</Target>

	<ItemGroup>
		<Compile Remove="research\**" />
		<Compile Remove="tests\**" />
		<Compile Remove="releases\**" />
		<Compile Remove="tools\**" />
		<Compile Remove="Frontend\**" />
		<None Remove="research\**" />
		<None Remove="tests\**" />
		<None Remove="releases\**" />
		<None Remove="Frontend\**" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game"><Private>false</Private></Reference>
		<Reference Include="Colossal.Core"><Private>false</Private></Reference>
		<Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
		<Reference Include="Colossal.Collections"><Private>false</Private></Reference>
		<Reference Include="Colossal.Logging"><Private>false</Private></Reference>
		<Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
		<Reference Include="Colossal.Localization"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
		<Reference Include="Unity.InputSystem"><Private>false</Private></Reference>
		<Reference Include="Unity.Burst"><Private>false</Private></Reference>
		<Reference Include="Unity.Collections"><Private>false</Private></Reference>
		<Reference Include="Unity.Entities"><Private>false</Private></Reference>
		<Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System"><Private>false</Private></Reference>
		<Reference Update="System.Core"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

</Project>
